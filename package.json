{
  "name": "@cityssm/whisper-speech-to-text",
  "version": "0.2.1",
  "description": "Locally converts recorded audio, like WAV files and MP3s, to text using OpenAI Whisper.",
  "keywords": [
    "openai",
    "whisper",
    "speech-to-text"
  ],
  "homepage": "https://github.com/cityssm/node-whisper-speech-to-text#readme",
  "bugs": {
    "url": "https://github.com/cityssm/node-whisper-speech-to-text/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/node-whisper-speech-to-text.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./debug": "./debug.config.js"
  },
  "main": "index.js",
  "files": [
    "debug.config.*",
    "index.*",
    "types.*"
  ],
  "scripts": {
     "coverage": "c8 --reporter=lcov --reporter=text --reporter=text-summary node --test test/test.js",
    "test": "node --test test/test.js"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^25.9.1",
    "eslint-config-cityssm": "^46.0.0",
    "prettier-config-cityssm": "^2.1.2"
  }
}
